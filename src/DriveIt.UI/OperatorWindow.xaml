<!--
    The Drive-It operator window: the workspace root, pending outside-root requests (approve or deny
    each once), and run history. In Dev Mode (spec #10) a caution banner says no guardrails apply and
    the outside-root requests pane is hidden: nothing waits for one. The Settings button opens the
    settings drawer (spec #23) over the window's right edge: one row per setting, today the Script
    time limit, the Require dry run switch, then the Agents row's Detect agents. With Require dry run on
    (spec #13 "The mode switcher"), a switcher at the top left offers Staged Actions mode, which gives the
    whole window to the last dry run that completed, and Home, the window as it is otherwise.
    Window conventions follow splash-it src/SplashIt.UI/Settings/SettingsWindow.xaml (splash-it
    commit ad7796d): Segoe UI 12, the palette's WindowBrush/TextBrush, Theme.xaml merged per window, Panel sections, banners, and
    the Primary/Danger buttons. The behavior is the former PowerShell window's
    (operator/DriveIt.Operator.ps1); all operator.js parsing and labels are in DriveIt.Core.
-->
<Window x:Class="DriveIt.UI.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DriveIt.Core.Operator;assembly=DriveIt.Core"
        Title="Drive-It"
        Width="920" Height="780" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="OperatorWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DriveIt.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="DetailsFont">Consolas, Courier New</FontFamily>

            <!-- Dims the window under the settings drawer, in both themes. -->
            <SolidColorBrush x:Key="ScrimBrush" Color="#000000" Opacity="0.4" />

            <!--
                List rows: a flat template in palette colors. The Windows (Aero2) row paints a fixed
                light-blue selection that loses the dark theme's light text.
            -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource DividerBrush}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OperatorList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <!--
                    Aero2's template with its disabled trigger left out: that trigger paints a fixed white
                    background, which shows in the dark theme while the settings drawer disables the window.
                -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The mode switcher's two choices (spec #13): flat segments in palette colors. The hidden semibold
                copy of the label holds each segment at its selected width, so choosing one moves nothing.
            -->
            <Style x:Key="ModeTab" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Segment" Background="Transparent" CornerRadius="3" Padding="12,4" SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Content}" FontWeight="SemiBold" Visibility="Hidden" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwitchFocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" RadiusX="13" RadiusY="13" StrokeThickness="1.5"
                                       Stroke="{StaticResource AccentForegroundBrush}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The Require dry run switch: a track and a knob, on when checked. -->
            <Style x:Key="SwitchToggle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource SwitchFocusRing}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" BorderThickness="1"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrongBorderBrush}"
                                    SnapsToDevicePixels="True">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                         Fill="{StaticResource MutedTextBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource CheckFillBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource CheckFillBrush}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{StaticResource CheckMarkBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource CheckFillHoverBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource CheckFillHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Also touched by Revit: one line, collapsed until clicked. -->
            <Style x:Key="Disclosure" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock x:Name="Chevron" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"
                                           Text="&#xE76C;" />
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DetailsBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontFamily" Value="{StaticResource DetailsFont}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- The window's content; inert under the drawer while it is open. -->
        <Grid x:Name="MainContent" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The mode switcher (spec #13), only with Require dry run on: the window's own control at its top
                left, Staged Actions first. Self-contained, so the rest of the window's layout can change around it.
            -->
            <Border x:Name="ModeSwitcher" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,8"
                    Padding="2" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    Background="{StaticResource SurfaceBrush}" Visibility="Collapsed"
                    AutomationProperties.Name="Mode" AutomationProperties.AutomationId="ModeSwitcher">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StagedTab" Style="{StaticResource ModeTab}" GroupName="Mode" Content="Staged Actions"
                                 Click="OnStagedTab" AutomationProperties.AutomationId="StagedActionsMode" />
                    <RadioButton x:Name="HomeTab" Style="{StaticResource ModeTab}" GroupName="Mode" Content="Home" IsChecked="True"
                                 Margin="2,0,0,0" Click="OnHomeTab" AutomationProperties.AutomationId="HomeMode" />
                </StackPanel>
            </Border>

            <!-- Settings: opens the drawer. Disabled while the window is busy. Its label is its name, so it has no tooltip. -->
            <Button x:Name="SettingsButton" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Style="{StaticResource IconButton}" Click="OnOpenSettings"
                    AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Text="&#xE713;" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Settings" />
                </StackPanel>
            </Button>

            <!-- Home: the window as it is without Staged Actions mode. -->
            <Grid x:Name="HomeContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="RequestsRow" Height="*" MinHeight="170" />
                <RowDefinition Height="1.3*" MinHeight="170" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dev Mode: shown for the whole life of the window; the mode changes only by reinstalling. -->
            <Border x:Name="DevModePanel" Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource WarningBanner}"
                    Visibility="Collapsed" AutomationProperties.Name="Dev Mode: no guardrails">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Dev Mode: no guardrails" />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Scripts run with your full Windows rights. Nothing is refused and nothing waits for your approval, so there are no outside-root requests. Use this install only on a machine you can restore." />
                </StackPanel>
            </Border>

            <!-- Workspace root -->
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionText}" Text="Workspace root" />
                    <TextBox x:Name="RootText" Grid.Row="1" AutomationProperties.Name="Workspace root" />
                    <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" MinWidth="96"
                            Content="Browse…" Click="OnBrowse" />
                    <Button x:Name="SaveRootButton" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Content="Save root" Click="OnSaveRoot" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Text="Scripts read and change files inside this folder without asking. A new root applies to future runs; history is kept." />
                </Grid>
            </Border>

            <!-- Errors from the last action; cleared by the next one that succeeds. Drawer actions show theirs in the drawer. -->
            <Border x:Name="ErrorPanel" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource ErrorBanner}"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Outside-root requests -->
            <Border x:Name="RequestsPanel" Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionText}" Text="Outside-root requests" />
                    <ListBox x:Name="RequestList" Grid.Row="1" Style="{StaticResource OperatorList}"
                             AutomationProperties.Name="Outside-root requests"
                             SelectionChanged="OnRequestSelected" />
                    <TextBlock x:Name="NoRequestsText" Grid.Row="1" Margin="10,8" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" IsHitTestVisible="False"
                               Text="No requests are waiting. When a script asks to work outside the root, it appears here." />
                    <TextBox x:Name="RequestDetails" Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailsBox}"
                             AutomationProperties.Name="Request details" />
                    <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" LastChildFill="False">
                        <Button x:Name="ApproveButton" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
                                Content="Approve this request" Click="OnApprove"
                                ToolTip="Allow this request once. The script retries it with the same idempotency key." />
                        <Button x:Name="DenyButton" DockPanel.Dock="Left" Margin="8,0,0,0" Style="{StaticResource DangerButton}"
                                Content="Deny this request" Click="OnDeny" />
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" MinWidth="96"
                                Content="Refresh" Click="OnRefresh" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Run history -->
            <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionText}" Text="Run history" />
                    <ListBox x:Name="HistoryList" Grid.Row="1" Style="{StaticResource OperatorList}"
                             AutomationProperties.Name="Run history"
                             SelectionChanged="OnHistorySelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel AutomationProperties.Name="{Binding Label}">
                                    <!-- A dry run carries its label as a badge beside its name (spec #13 "Receipts and the Library"). -->
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Badge}"
                                                Visibility="{Binding DryRun, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{x:Static core:HoldText.DryRunLabel}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,1,0,0" Text="{Binding Detail}" Style="{StaticResource MutedText}" ToolTip="{Binding Meta}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoHistoryText" Grid.Row="1" Margin="10,8" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" IsHitTestVisible="False"
                               Text="No runs yet." />
                    <TextBox x:Name="HistoryDetails" Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailsBox}"
                             AutomationProperties.Name="Run details" />
                </Grid>
            </Border>

            <TextBlock x:Name="McpText" Grid.Row="5" Margin="2,10,0,0" Style="{StaticResource MutedText}" />
            </Grid>

            <!--
                Staged Actions mode (spec #13): the whole window for the last dry run that completed in this
                workspace. Name, time, document and outcome, Applied when the same call has since run for real,
                then per document Created, Modified and Deleted as readable lists, Also touched by Revit collapsed,
                the images and the workshared release line. No JSON; the receipt stays in run history.
            -->
            <ScrollViewer x:Name="StagedPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                          AutomationProperties.Name="Staged Actions" AutomationProperties.AutomationId="StagedActions">
                <StackPanel Margin="0,4,4,0">
                    <Border x:Name="StagedErrorPanel" Margin="0,0,0,10" Style="{StaticResource ErrorBanner}" Visibility="Collapsed">
                        <TextBlock x:Name="StagedErrorText" Style="{StaticResource ErrorText}" />
                    </Border>
                    <TextBlock x:Name="StagedReadingText" Style="{StaticResource MutedText}" Visibility="Collapsed"
                               AutomationProperties.AutomationId="StagedReading" />
                    <Border x:Name="StagedNonePanel" Style="{StaticResource Panel}" Padding="16,14" Visibility="Collapsed">
                        <TextBlock x:Name="StagedNoneText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="StagedNone" />
                    </Border>
                    <StackPanel x:Name="StagedRunPanel" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="AppliedBadge" DockPanel.Dock="Right" Margin="12,3,0,0" VerticalAlignment="Top"
                                    Style="{StaticResource Badge}" Padding="10,1,10,2" Visibility="Collapsed"
                                    AutomationProperties.Name="Applied" ToolTip="{x:Static core:StagedText.AppliedHelp}">
                                <TextBlock x:Name="AppliedText" Style="{StaticResource BadgeText}" FontSize="12" />
                            </Border>
                            <TextBlock x:Name="StagedTitle" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="StagedMeta" Margin="0,4,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <!-- A dry run that did not succeed: what happened, its error, and whether the model is as it was. -->
                        <Border x:Name="StagedFailurePanel" Margin="0,12,0,0" Style="{StaticResource ErrorBanner}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="StagedFailureLead" Style="{StaticResource ErrorText}" FontWeight="SemiBold" />
                                <TextBlock x:Name="StagedFailureText" Margin="0,2,0,0" Style="{StaticResource ErrorText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StagedFailureNote" Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <!-- What the lists are: nothing has been changed yet, or the same call has since run for real. -->
                        <TextBlock x:Name="StagedLead" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="StagedNothingText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ItemsControl x:Name="StagedDocuments" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,12">
                                        <StackPanel>
                                            <!-- The document, as a header band over its lists. -->
                                            <Border Padding="12,8" CornerRadius="3,3,0,0" BorderThickness="0,0,0,1"
                                                    BorderBrush="{StaticResource DividerBrush}" Background="{StaticResource SurfaceAltBrush}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource IconFont}" FontSize="13"
                                                               Foreground="{StaticResource MutedTextBrush}" Text="&#xE8A5;" />
                                                    <TextBlock Style="{StaticResource SectionText}" Margin="0" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Title}" />
                                                </DockPanel>
                                            </Border>
                                            <StackPanel Margin="12,12,12,4">
                                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,12">
                                                                <!-- Created, Modified or Deleted, each with its own mark so deletions are found at a glance. -->
                                                                <DockPanel>
                                                                    <TextBlock x:Name="Mark" DockPanel.Dock="Left" Width="20" VerticalAlignment="Center"
                                                                               FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE710;"
                                                                               Foreground="{StaticResource AccentForegroundBrush}" />
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="20,0,0,0" Focusable="False">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,5,0,0">
                                                                                <!-- Runs on one line of XAML: a break between them would show as a space. -->
                                                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" /></TextBlock>
                                                                                <ItemsControl ItemsSource="{Binding Changes}" Margin="14,1,0,0" Focusable="False">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <!-- "Mark: D12 → D14": the name and the old value muted, the new value in full. -->
                                                                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Before, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding After, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /></TextBlock>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <ItemsControl ItemsSource="{Binding Details}" Margin="14,1,0,0" Focusable="False">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding}" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="{x:Static core:StagedText.Modified}">
                                                                    <Setter TargetName="Mark" Property="Text" Value="&#xE70F;" />
                                                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Name}" Value="{x:Static core:StagedText.Deleted}">
                                                                    <Setter TargetName="Mark" Property="Text" Value="&#xE74D;" />
                                                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerForegroundBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Margin="0,0,0,8" Visibility="{Binding AlsoTouched, Converter={StaticResource NullToCollapsed}}">
                                                    <ToggleButton x:Name="AlsoTouchedToggle" Style="{StaticResource Disclosure}" Content="{Binding AlsoTouched}"
                                                                  ToolTip="{x:Static core:StagedText.AlsoTouchedHelp}" />
                                                    <ItemsControl ItemsSource="{Binding AlsoTouchedLines}" Margin="20,2,0,0" Focusable="False"
                                                                  Visibility="{Binding IsChecked, ElementName=AlsoTouchedToggle, Converter={StaticResource BoolToVisible}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- The dry run's images: one card each, the same size whether the view was exported or not. -->
                        <StackPanel x:Name="StagedImagesPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionText}" Margin="0,0,0,8" Text="{x:Static core:StagedText.ImagesHeading}" />
                            <ItemsControl x:Name="StagedImages" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="400" Margin="0,0,12,12" Padding="0" Style="{StaticResource Panel}">
                                            <StackPanel>
                                                <Grid Height="260">
                                                    <Image Margin="1" Source="{Binding Image}" Stretch="Uniform" />
                                                    <StackPanel Margin="24,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                                   Foreground="{StaticResource MutedTextBrush}" Text="&#xE8B9;" />
                                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                                   TextAlignment="Center" Text="{Binding Error}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Padding="12,7" CornerRadius="0,0,3,3" BorderThickness="0,1,0,0"
                                                        BorderBrush="{StaticResource DividerBrush}" Background="{StaticResource SurfaceAltBrush}">
                                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Caption}" ToolTip="{Binding Caption}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl x:Name="StagedWorksharing" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource InfoBanner}">
                                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="StagedIdsNote" Margin="0,0,0,8" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The dimmed rest of the window while the drawer is open; a click here closes the drawer. -->
        <Border x:Name="DrawerScrim" Background="{StaticResource ScrimBrush}" Visibility="Collapsed"
                MouseLeftButtonDown="OnScrimClicked" AutomationProperties.AutomationId="SettingsScrim" />

        <!-- The settings drawer (spec #23): the window's right edge, full height, over the content. -->
        <Border x:Name="Drawer" HorizontalAlignment="Right" Width="380" Visibility="Collapsed"
                Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource StrongBorderBrush}"
                BorderThickness="1,0,0,0" Focusable="True" FocusVisualStyle="{x:Null}"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsDrawer">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="OnCloseSettings" AutomationProperties.Name="Close settings" ToolTip="Close">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE711;" />
                    </Button>
                    <TextBlock Style="{StaticResource HeadingText}" VerticalAlignment="Center" Text="Settings" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <!-- One panel per setting: a further setting is one more panel here, with its own error line. -->
                    <StackPanel x:Name="SettingsRows">

                        <!-- Script time limit (spec #15 "Time Limit and Long Jobs"); the add-in and the server both enforce it. -->
                        <Border x:Name="TimeLimitRow" Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="4" Style="{StaticResource SectionText}" Text="Script time limit" />
                                <TextBox x:Name="TimeLimitText" Grid.Row="1" Width="72" HorizontalContentAlignment="Right"
                                         KeyDown="OnTimeLimitKeyDown"
                                         AutomationProperties.Name="Script time limit in seconds" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="seconds" />
                                <Button x:Name="SaveTimeLimitButton" Grid.Row="1" Grid.Column="3" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Content="Save limit" Click="OnSaveTimeLimit" />
                                <TextBlock x:Name="TimeLimitError" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0"
                                           Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                           AutomationProperties.Name="Script time limit error" />
                                <TextBlock x:Name="TimeLimitHelp" Grid.Row="3" Grid.ColumnSpan="4" Margin="0,6,0,0"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!--
                            Require dry run (spec #13 "The drawer row"): saved at once on click; on failure the switch
                            returns to the stored value and the error shows here.
                        -->
                        <Border x:Name="RequireDryRunRow" Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="0" Text="Require dry run" />
                                <CheckBox x:Name="RequireDryRunSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          VerticalAlignment="Center" Click="OnRequireDryRunClicked"
                                          AutomationProperties.Name="Require dry run" AutomationProperties.AutomationId="RequireDryRunSwitch" />
                                <TextBlock x:Name="RequireDryRunErrorLine" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                           Style="{StaticResource ErrorText}" Visibility="Collapsed"
                                           AutomationProperties.Name="Require dry run error" />
                                <TextBlock x:Name="RequireDryRunHelp" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!--
                            Agents (spec #23 "Detect Agents"): the installer's MCP client registration on demand,
                            for a Claude or ChatGPT installed after Drive-It. One plain line per client.
                        -->
                        <Border x:Name="AgentsRow" Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="Agents" />
                                <Button x:Name="DetectAgentsButton" HorizontalAlignment="Left" MinWidth="112"
                                        Content="Detect agents" Click="OnDetectAgents" />
                                <TextBlock x:Name="AgentsError" Margin="0,6,0,0" Style="{StaticResource ErrorText}"
                                           Visibility="Collapsed" AutomationProperties.Name="Detect agents error" />
                                <!-- One line per client, with a mark for how it went: added, already there, not installed, could not add. -->
                                <ItemsControl x:Name="AgentResults" Margin="0,8,0,2" Visibility="Collapsed" Focusable="False"
                                              AutomationProperties.Name="Detect agents results">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock x:Name="Mark" DockPanel.Dock="Left" Width="20" Margin="0,3,0,0" VerticalAlignment="Top"
                                                           FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE73E;"
                                                           Foreground="{StaticResource AccentForegroundBrush}" />
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="already">
                                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="not_installed">
                                                    <Setter TargetName="Mark" Property="Text" Value="&#xE738;" />
                                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                                    <Setter TargetName="Mark" Property="Text" Value="&#xE783;" />
                                                    <Setter TargetName="Mark" Property="FontSize" Value="12" />
                                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Adds Drive-It to Claude and ChatGPT on this computer. Use it after you install one of them. Then restart that app." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
