<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.0.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.0.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <None Update="DriveIt.addin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ribbon and window icons, loaded from disk next to the DLL when present (drive_16/32[_dark].png). -->
    <None Include="Resources\icons\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings; the broker relies on it. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- The operator window; it ships next to DriveIt.Revit.dll in the add-in folder. -->
    <ProjectReference Include="..\DriveIt.UI\DriveIt.UI.csproj" />
  </ItemGroup>
</Project>
