<!--
  Per-user Drive-It MSI, an RST family companion (rst-c companions/README.md, C1-C7).
  The MSI owns the package files under %LOCALAPPDATA%\DriveIt; Install-DriveIt.ps1 then
  verifies the runtimes, runs the MCP smoke check, and registers the Revit add-in, MCP
  configuration, and shortcut in place. Uninstall-DriveIt.ps1 removes those registrations;
  user data stays. installer/inspect-msi.ps1 checks the built MSI against the contract.

  Build: installer/Build-DriveItMsi.ps1, which runs
         wix build installer/DriveIt.wxs -arch x64 -ext WixToolset.Util.wixext
         -bindpath pkg=<package directory> -d Version=<x.y.z> -d StopCommand=<base64> -o <msi>

  Silent and reboot-free (C4): RST's tray runs
    msiexec /i DriveIt-X.Y.Z.msi /qn /norestart MSIRESTARTMANAGERCONTROL=Disable
  and counts 3010 as a failure. With the Restart Manager off, any file still open when the
  old version is removed or the new one is written is queued for a reboot, so
  StopDriveItProcesses ends Drive-It's own processes first (see below). Revit is never
  stopped: a running Revit holding DriveIt.Revit.dll is the one known 3010 case.

  UpgradeCode is the stable identity of the product. NEVER change it: it is how Windows
  Installer upgrades a prior install in place, and RST's tray depends on it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Drive-It" Manufacturer="Designs/OS" Version="$(Version)"
           UpgradeCode="6561188A-BD8D-43A9-B116-BA0894F8001B" Scope="perUser" Language="1033">
    <SummaryInformation Description="Drive-It: MCP server and add-in for Autodesk Revit 2026" />

    <!-- The old version is removed before anything new is installed, inside this install's
         transaction (afterInstallInitialize), so a failed upgrade rolls the removal back and the
         previous install stays whole. The default (afterInstallValidate) commits the removal on
         its own first: a refused upgrade (RegisterDriveIt's Dev Mode gate, an invalid
         DRIVEIT_MODE) then left Drive-It uninstalled with its registrations pointing at deleted
         files. A newer installed version is never downgraded (C3). -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <!-- Lay down every file whatever version is on disk. Files are costed while the old version
         is still installed, so a DLL whose file version went down (alpha.1/alpha.2 shipped
         1.0.0.0; builds now carry the package version) was skipped as "older", then deleted
         with the old version, and RegisterDriveIt failed with Drive-It uninstalled. Every file
         is private to %LOCALAPPDATA%\DriveIt, so forcing them touches nothing shared. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Settings > Apps identity and links, as the sibling companions. -->
    <Icon Id="DriveItIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)branding\driveit.ico" />
    <Property Id="ARPPRODUCTICON" Value="DriveItIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jedbjorn/drive-it#install" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jedbjorn/drive-it" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jedbjorn/drive-it/releases/latest" />

    <!-- Revit 2026 detection, the same AppSearch pair as splash-it installer/Product.wxs:
         REVIT2026FOUND is the path of Revit.exe when either search finds it (a search that
         finds nothing leaves the property alone, so the two act as an OR):
           1. the folder in InstallLocation of Revit 2026's uninstall entry (64-bit HKLM);
           2. the default folder, C:\Program Files\Autodesk\Revit 2026\.
         A folder without Revit.exe (a leftover) does not count. -->
    <Property Id="REVIT2026FOUND" Secure="yes">
      <RegistrySearch Id="Revit2026InstallLocation" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{7346B4A0-2600-0510-0000-705C0D862004}"
                      Name="InstallLocation" Type="directory" Bitness="always64">
        <DirectorySearch Id="Revit2026ExeInInstallLocation" Depth="0">
          <FileSearch Name="Revit.exe" />
        </DirectorySearch>
      </RegistrySearch>
      <DirectorySearch Id="Revit2026ExeInDefaultFolder"
                       Path="[ProgramFiles64Folder]Autodesk\Revit 2026" Depth="0">
        <FileSearch Name="Revit.exe" />
      </DirectorySearch>
    </Property>

    <!-- A first install needs Revit 2026. "Installed" keeps repair and uninstall available
         on a computer that no longer has it (an uninstall must always work). -->
    <Launch Condition="Installed OR REVIT2026FOUND"
            Message="Drive-It needs Autodesk Revit 2026, and it was not found on this computer." />

    <!-- An administrative install (msiexec /a) only unpacks files; inspect-msi.ps1 and
         verify-signatures.ps1 use one on a CI runner without Revit. -->
    <AdminUISequence>
      <LaunchConditions Suppress="yes" />
    </AdminUISequence>
    <AdminExecuteSequence>
      <LaunchConditions Suppress="yes" />
    </AdminExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DriveIt" />
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.pkg)\**" />
    </Feature>

    <!-- Stops every process whose image is under %LOCALAPPDATA%\DriveIt\app (the private
         node.exe an MCP client keeps running, its python.exe worker, DriveIt.Operator.exe)
         before InstallValidate, so neither the removal of the old version
         (RemoveExistingProducts) nor this install's file operations meet a file in use.
         Immediate, because it must run before InstallValidate checks for files in use. The script cannot come from the install folder: on
         an upgrade that folder still holds the previous version, which may not have it. So
         Build-DriveItMsi.ps1 embeds installer/Stop-DriveItProcesses.ps1 as an encoded
         command. It runs after FindRelatedProducts and LaunchConditions, so a blocked
         downgrade or a computer without Revit stops nothing. Return="ignore": a failure
         here surfaces as the file-in-use 3010 it exists to prevent. The command is a plain
         Property (no length limit) that WixQuietExec formats when it runs, which resolves
         [System64Folder]; base64 holds no brackets for the formatter to touch. -->
    <Property Id="WixQuietExecCmdLine"
              Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $(StopCommand)" />
    <CustomAction Id="StopDriveItProcesses" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <!-- The install mode (spec #10 "Mode Selection"), on the command line only, never in a UI:
         msiexec /i DriveIt.msi DRIVEIT_MODE=dev from an elevated administrator prompt. Not set,
         Install-DriveIt.ps1 keeps the recorded mode (upgrade, repair) or installs standard; it
         validates the value and holds the elevated-administrator gate, where the deferred
         action's token is observable. A refusal on an upgrade rolls back the old version's
         removal (MajorUpgrade above), so the existing install is unchanged. Secure: a public property reaches the execute sequence.
         -Mode is passed only when the property is set (powershell.exe -File drops an empty "").
         RST's command lines never pass it, so RST installs are standard. -->
    <Property Id="DRIVEIT_MODE" Secure="yes" />
    <SetProperty Id="DriveItModeArgument" Sequence="execute" After="CostFinalize" Condition="DRIVEIT_MODE"
                 Value=" -Mode &quot;[DRIVEIT_MODE]&quot;" />

    <!-- "[INSTALLFOLDER]." keeps the trailing backslash from escaping the closing quote. -->
    <SetProperty Id="RegisterDriveIt" Sequence="execute" Before="RegisterDriveIt"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Install-DriveIt.ps1&quot; -SourcePath &quot;[INSTALLFOLDER].&quot; -InstallRoot &quot;[INSTALLFOLDER].&quot; -NoLaunch[DriveItModeArgument]" />
    <CustomAction Id="RegisterDriveIt" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="check" />

    <SetProperty Id="UnregisterDriveIt" Sequence="execute" Before="UnregisterDriveIt"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Uninstall-DriveIt.ps1&quot; -InstallRoot &quot;[INSTALLFOLDER].&quot;" />
    <CustomAction Id="UnregisterDriveIt" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopDriveItProcesses" Before="InstallValidate" />
      <Custom Action="RegisterDriveIt" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="UnregisterDriveIt" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
